# ==============================================================================
# Privacy-Aware Remote Patient Monitoring System (IoMT & Edge Computing)
# Root Environment Variable Configuration Template
# Copy this file to .env before starting via Docker Compose or native services
# ==============================================================================

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=iomt_rpm
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iomt_rpm?schema=public

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Backend API Configuration
PORT=5001
NODE_ENV=production
FRONTEND_URL=http://localhost:5173

# Security & Cryptography Keys (Replace with strong random strings in production)
JWT_ACCESS_SECRET=academic-rpm-access-secret-2026-secure-key-32chars
JWT_REFRESH_SECRET=academic-rpm-refresh-secret-2026-secure-key-32chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
DATA_AT_REST_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Edge Gateway Configuration
EDGE_PORT=5005
BACKEND_URL=http://localhost:5001/api

# Frontend Public Variables
VITE_API_URL=http://localhost:5001/api
VITE_WS_URL=http://localhost:5001
