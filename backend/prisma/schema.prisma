generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DOCTOR
  NURSE
}

enum RiskLevel {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum PatientStatus {
  ACTIVE
  DISCHARGED
  OBSERVATION
}

enum DeviceType {
  SMARTWATCH
  ECG_PATCH
  PULSE_OXIMETER
  BP_CUFF
  EDGE_GATEWAY
  MULTI_PARAM_MONITOR
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  DEGRADED
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum ConsentStatus {
  GRANTED
  REVOKED
  EXPIRED
  PENDING
}

enum ConsentPurpose {
  REMOTE_MONITORING
  EMERGENCY_CARE
  CLINICAL_RESEARCH
  TELEMETRY_INGESTION
  AI_MODEL_TRAINING
  THIRD_PARTY_AUDIT
}

model User {
  id            String            @id @default(uuid())
  name          String
  email         String            @unique
  passwordHash  String
  role          Role              @default(DOCTOR)
  isActive      Boolean           @default(true)
  department    String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  patients      Patient[]         @relation("DoctorPatients")
  refreshTokens RefreshToken[]
  auditLogs     PrivacyAuditLog[]
  auditLogsList AuditLog[]

  @@index([email])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model Patient {
  id                 String         @id @default(uuid())
  patientCode        String         @unique
  name               String
  dateOfBirth        DateTime
  gender             String
  contactInformation String?
  assignedDoctorId   String?
  assignedDoctor     User?          @relation("DoctorPatients", fields: [assignedDoctorId], references: [id], onDelete: SetNull)
  medicalHistory     String?
  condition          String?        @default("Under Observation")
  riskLevel          RiskLevel      @default(LOW)
  roomOrLocation     String?
  status             PatientStatus  @default(ACTIVE)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  devices            Device[]       @relation("PatientDevices")
  vitalReadings      VitalReading[] @relation("PatientVitals")
  edgeDevices        EdgeDevice[]
  vitals             VitalRecord[]
  alerts             Alert[]
  consents           PatientConsent[]

  @@index([patientCode])
  @@index([name])
  @@index([assignedDoctorId])
}

model Device {
  id              String         @id @default(uuid())
  deviceCode      String         @unique
  name            String
  deviceType      DeviceType     @default(SMARTWATCH)
  status          DeviceStatus   @default(ONLINE)
  batteryLevel    Int            @default(100)
  firmwareVersion String?        @default("v2.4.1-sim")
  edgeNodeId      String?        @default("EDGE-GATEWAY-RPI4-01")
  apiKey          String         @unique
  isSimulated     Boolean        @default(true)
  lastHeartbeat   DateTime       @default(now())

  patientId       String?
  patient         Patient?       @relation("PatientDevices", fields: [patientId], references: [id], onDelete: SetNull)

  readings        VitalReading[]
  alerts          Alert[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([patientId])
  @@index([status])
  @@index([apiKey])
}

model VitalReading {
  id               String       @id @default(uuid())
  patientId        String
  patient          Patient      @relation("PatientVitals", fields: [patientId], references: [id], onDelete: Cascade)
  deviceId         String
  device           Device       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  heartRate        Float        // bpm
  spo2             Float        // %
  bloodPressureSys Float        // mmHg
  bloodPressureDia Float        // mmHg
  temperature      Float        // °C
  respiratoryRate  Float?       // rpm
  isSimulated      Boolean      @default(true)
  scenario         String       @default("NORMAL")
  recordedAt       DateTime     @default(now())
  createdAt        DateTime     @default(now())

  @@index([patientId, recordedAt])
  @@index([deviceId, recordedAt])
  @@index([recordedAt])
}

model EdgeDevice {
  id            String       @id @default(uuid())
  deviceName    String
  deviceType    DeviceType   @default(SMARTWATCH)
  macAddress    String       @unique
  edgeNodeId    String
  status        DeviceStatus @default(ONLINE)
  batteryLevel  Int          @default(100)
  lastHeartbeat DateTime     @default(now())
  patientId     String?
  patient       Patient?     @relation(fields: [patientId], references: [id])
  vitals        VitalRecord[]
  alerts        Alert[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model VitalRecord {
  id                String      @id @default(uuid())
  patientId         String
  patient           Patient     @relation(fields: [patientId], references: [id])
  edgeDeviceId      String?
  edgeDevice        EdgeDevice? @relation(fields: [edgeDeviceId], references: [id])
  heartRate         Int
  spo2              Int
  bloodPressureSys  Int?
  bloodPressureDia  Int?
  temperature       Float?
  respiratoryRate   Int?
  isEdgeFiltered    Boolean     @default(true)
  noiseAdded        Float       @default(0.0)
  epsilonBudgetUsed Float       @default(0.01)
  recordedAt        DateTime    @default(now())
  createdAt         DateTime    @default(now())

  @@index([patientId, recordedAt])
}

model Alert {
  id              String        @id @default(uuid())
  patientId       String
  patient         Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  deviceId        String?
  device          Device?       @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  edgeDeviceId    String?
  edgeDevice      EdgeDevice?   @relation(fields: [edgeDeviceId], references: [id])
  vitalType       String        @default("HEART_RATE")
  alertType       String        @default("VITAL_ANOMALY")
  severity        AlertSeverity @default(WARNING)
  message         String
  source          String        @default("EDGE_GATEWAY")
  status          AlertStatus   @default(OPEN)
  triggeredAt     DateTime      @default(now())
  acknowledgedAt  DateTime?
  resolvedAt      DateTime?
  acknowledgedBy  String?
  resolvedBy      String?
  resolutionNotes String?
  currentValue    String?
  thresholdValue  String?
  isAcknowledged  Boolean       @default(false)
  isResolved      Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @default(now()) @updatedAt

  @@index([patientId, status])
  @@index([patientId, severity])
  @@index([status])
  @@index([severity])
  @@index([triggeredAt])
  @@index([deviceId])
}

model PrivacyAuditLog {
  id         String   @id @default(uuid())
  action     String
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  patientId  String?
  edgeNodeId String?
  details    String
  ipAddress  String?
  timestamp  DateTime @default(now())

  @@index([timestamp])
}

model PrivacyConfig {
  id                         String   @id @default(uuid())
  differentialPrivacyEnabled Boolean  @default(true)
  epsilon                    Float    @default(0.5)
  delta                      Float    @default(0.00001)
  anonymizationLevel         String   @default("K-Anonymity (k=5)")
  edgeBandwidthSavingPercent Float    @default(74.5)
  updatedAt                  DateTime @updatedAt
}

model PatientConsent {
  id                 String         @id @default(uuid())
  patientId          String
  patient            Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  purpose            ConsentPurpose @default(REMOTE_MONITORING)
  status             ConsentStatus  @default(GRANTED)
  grantedBy          String?        @default("Patient (Self)")
  grantedAt          DateTime       @default(now())
  expiresAt          DateTime?
  revokedAt          DateTime?
  revokedBy          String?
  revocationReason   String?
  authorizedRoles    String[]       @default(["DOCTOR", "NURSE", "ADMIN"])
  authorizedPurposes String[]       @default(["REMOTE_MONITORING", "EMERGENCY_CARE"])
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @default(now()) @updatedAt

  @@index([patientId, status])
  @@index([patientId, purpose])
  @@index([status])
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName     String?
  userEmail    String?
  userRole     String?
  action       String
  resourceType String
  resourceId   String?
  metadata     String?
  ipAddress    String?
  userAgent    String?
  status       String   @default("SUCCESS")
  timestamp    DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([resourceType, resourceId])
  @@index([timestamp])
  @@index([status])
}
