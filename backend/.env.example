# Server Configuration
PORT=5001
NODE_ENV=development

# PostgreSQL Database Connection
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/iomt_rpm?schema=public"

# Redis In-Memory Cache & BullMQ Queue Store
REDIS_URL="redis://localhost:6379"

# Cryptography & Sensitive Data-at-Rest Encryption (AES-256-GCM 32-byte key)
DATA_AT_REST_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# CORS Allowed Origin
FRONTEND_URL="http://localhost:5173"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="your-access-token-secret-at-least-32-chars"
JWT_REFRESH_SECRET="your-refresh-token-secret-at-least-32-chars"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Edge Gateway Configuration (IoMT Simulator)
EDGE_GATEWAY_PORT=5005
EDGE_ENCRYPTION_KEY="secret-edge-token-academic-demo"
